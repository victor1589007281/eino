# MCP Agent Tools 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== 搜索引擎 API ====================
# Serper (Google 搜索代理) - https://serper.dev/
SERPER_API_KEY=

# Tavily (AI 优化搜索) - https://tavily.com/
TAVILY_API_KEY=

# Exa.ai (语义搜索) - https://exa.ai/
EXA_API_KEY=

# Brave Search (可选) - https://brave.com/search/api/
BRAVE_API_KEY=

# ==================== AI/LLM 服务 ====================
# DeepSeek API - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ==================== 邮箱凭证 ====================
# QQ 邮箱
EMAIL_QQ_USERNAME=your_email@qq.com
EMAIL_QQ_PASSWORD=your_app_specific_password

# ==================== 数据库服务 ====================
# Redis
REDIS_PASSWORD=

# PostgreSQL
POSTGRES_DSN=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Neo4j
NEO4J_PASSWORD=

# ==================== 对象存储 ====================
# S3/MinIO
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==================== 可选服务 ====================
# Adzuna 招聘 API - https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
